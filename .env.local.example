# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Video generation provider: "mock" works out of the box for local dev/demo.
# Set to "heygen" once you have a HeyGen API key to render real avatar videos.
VIDEO_PROVIDER=mock
HEYGEN_API_KEY=
