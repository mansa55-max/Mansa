# Clé API TMDB (gratuite) pour la recherche de films — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Clé API Anthropic (optionnelle) pour des résumés générés par IA au lieu du résumé
# automatique local. Sans clé, l'appli utilise un résumé extractif 100% local.
ANTHROPIC_API_KEY=

# Modèle Whisper local utilisé pour la transcription vidéo : tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Taille max des fichiers vidéo importés (en Mo)
MAX_UPLOAD_SIZE_MB=3000
